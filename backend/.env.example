# ==========================================
# CheapFood Backend - Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores.
# ==========================================

# Chave secreta para assinatura de tokens de autenticação (gere uma segura em produção)
SECRET_KEY=sua-chave-secreta-super-segura-aqui

# Modo Debug (False em produção)
FLASK_DEBUG=False

# Modo Demonstração (em produção real, mude para False para desligar reset de dados e exibir links de senha)
DEMO_MODE=True

# Porta do servidor (Render/Railway/Heroku definem isso automaticamente)
PORT=5000

# URL do frontend para CORS e links de redefinição de senha
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,https://cheapfood.vercel.app

# Banco de dados: SQLite local por padrão, ou string de conexão PostgreSQL (ex.: Neon, Render Postgres)
# DATABASE_URL=postgresql://user:password@host/database
DATABASE_URL=sqlite:///../cheapfood.db

# Pasta de uploads (em hosts com disco persistente, aponte para o ponto de montagem)
# UPLOAD_FOLDER=/var/data/uploads

# Chave da API do Google Gemini (para análise e preenchimento automático por foto)
GEMINI_API_KEY=

# Envio de e-mail real para redefinição de senha (opcional; sem isso, no modo demo o link é exibido na tela)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASSWORD=sua-senha-de-app
# SMTP_FROM=CheapFood <seu-email@gmail.com>
